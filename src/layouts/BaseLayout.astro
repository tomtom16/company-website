---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = "Haut mit Herz – Ihre Dermatologin in Wien. Persönliche Betreuung, modernste Behandlungen." } = Astro.props;

const navLinks = [
  { href: "/", label: "Start" },
  { href: "/about", label: "Über mich" },
  { href: "/services", label: "Leistungen" },
  { href: "/contact", label: "Kontakt" },
  { href: "/contact-form", label: "Anfrage" },
];

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Haut mit Herz</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="manifest" href="/site.webmanifest">
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body class="bg-cream-100 text-[#1a1a1a] font-sans antialiased">

    <!-- Navbar -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-cream-100/95 backdrop-blur-md border-b border-cream-300 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-2.5 group">
            <div class="w-9 h-9 rounded-full bg-[#1a1a1a] flex items-center justify-center flex-shrink-0">
              <span class="text-cream-100 text-lg">🌿</span>
            </div>
            <div class="leading-tight">
              <span class="font-display font-bold text-lg text-[#1a1a1a] group-hover:text-brand-700 transition-colors block">Haut mit Herz</span>
              <span class="text-xs text-gray-500 font-medium block -mt-0.5">Dermatologie &amp; Ästhetik</span>
            </div>
          </a>

          <!-- Desktop nav -->
          <nav class="hidden md:flex items-center gap-1">
            {navLinks.map(link => (
              <a
                href={link.href}
                class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${
                  currentPath === link.href
                    ? 'bg-brand-200 text-brand-800'
                    : 'text-gray-700 hover:text-[#1a1a1a] hover:bg-cream-200'
                }`}
              >
                {link.label}
              </a>
            ))}
            <a href="https://patient.latido.at/arzt/_Scherz" target="_blank" rel="noopener" class="ml-3 px-5 py-2 bg-[#1a1a1a] hover:bg-[#2d2d2d] text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">
              Terminvereinbarung
            </a>
          </nav>

          <!-- Mobile hamburger -->
          <button id="menu-toggle" class="md:hidden p-2 rounded-lg text-gray-700 hover:bg-cream-200 transition-colors" aria-label="Menü öffnen">
            <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-cream-300 bg-cream-100">
        <div class="px-4 py-3 space-y-1">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`block px-4 py-2.5 rounded-lg text-sm font-medium transition-all ${
                currentPath === link.href
                  ? 'bg-brand-200 text-brand-800'
                  : 'text-gray-700 hover:text-[#1a1a1a] hover:bg-cream-200'
              }`}
            >
              {link.label}
            </a>
          ))}
          <a href="https://patient.latido.at/arzt/_Scherz" target="_blank" rel="noopener" class="block mt-2 px-4 py-2.5 bg-[#1a1a1a] hover:bg-[#2d2d2d] text-white text-sm font-semibold rounded-lg transition-colors text-center">
            Terminvereinbarung
          </a>
        </div>
      </div>
    </header>

    <!-- Page content -->
    <main class="pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-[#1a1a1a] text-gray-300 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2.5 mb-4">
              <div class="w-9 h-9 rounded-full bg-cream-200 flex items-center justify-center">
                <span class="text-lg">🌿</span>
              </div>
              <div>
                <span class="font-display font-bold text-lg text-white block">Haut mit Herz</span>
                <span class="text-xs text-gray-400 block -mt-0.5">Dermatologie &amp; Ästhetik</span>
              </div>
            </div>
            <p class="text-gray-400 text-sm leading-relaxed max-w-xs">
              Persönliche und einfühlsame dermatologische Betreuung in Wien. Ihre Gesundheit und Ihr Wohlbefinden liegen mir am Herzen.
            </p>
            <div class="mt-4 space-y-1 text-sm">
              <p><a href="tel:+436776231552" class="text-gray-300 hover:text-white transition-colors">📱 0677 623 11 552</a></p>
              <p><a href="mailto:termin@hautmitherz.at" class="text-gray-300 hover:text-white transition-colors">✉️ termin@hautmitherz.at</a></p>
            </div>
          </div>
          <div>
            <h4 class="text-white font-semibold text-sm mb-4">Navigation</h4>
            <ul class="space-y-2 text-sm">
              {navLinks.map(link => (
                <li><a href={link.href} class="hover:text-white transition-colors">{link.label}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold text-sm mb-4">Rechtliches</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/imprint" class="hover:text-white transition-colors">Impressum</a></li>
              <li><a href="/data-protection" class="hover:text-white transition-colors">Datenschutz</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-white/10 mt-10 pt-6 text-sm text-gray-500 flex flex-col sm:flex-row justify-between gap-2">
          <span>&nbsp;</span>
          <span>© {new Date().getFullYear()} Thomas Rotter, MSc. Alle Rechte vorbehalten.</span>
          <span>&nbsp;</span>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');
      toggle?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
