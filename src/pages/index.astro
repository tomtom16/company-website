---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Startseite" description="Haut mit Herz – Ihr Dermatologe in Wien. Persönliche Betreuung, modernste Behandlungen für gesunde und strahlende Haut.">

  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-20 left-10 w-72 h-72 bg-cream-200 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-20 w-96 h-96 bg-brand-300 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28 lg:py-36">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block px-4 py-1.5 bg-white/10 text-cream-200 text-xs font-semibold rounded-full mb-6 tracking-wider uppercase">Dermatologie &amp; Ästhetik · Wien</span>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
            Ihre Haut in <span class="text-brand-300">besten Händen</span>
          </h1>
          <p class="text-gray-300 text-lg leading-relaxed mb-8 max-w-lg">
            Einfühlsame, individuelle Betreuung durch einen erfahrenen Dermatologen – von medizinischer Diagnostik bis zu ästhetischen Behandlungen, die Ihr natürliches Strahlen unterstreichen.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="https://patient.latido.at/arzt/_Scherz" target="_blank" rel="noopener" class="px-7 py-3.5 bg-cream-100 hover:bg-white text-[#1a1a1a] font-semibold rounded-xl transition-all shadow-lg">
              Termin vereinbaren
            </a>
            <a href="/services" class="px-7 py-3.5 border border-white/30 hover:border-white text-white font-semibold rounded-xl transition-all">
              Alle Leistungen
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img
            src="/images/home_intro.jpg"
            alt="Dermatologe in der Praxis"
            class="rounded-2xl shadow-2xl w-full object-cover h-[420px]"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Quick contact bar -->
  <section class="bg-cream-200 border-b border-cream-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="bg-white rounded-2xl border border-cream-300 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
          <tbody>
            <tr class="border-b border-cream-200">
              <td class="px-6 py-4 font-semibold text-gray-500 w-1/3 bg-cream-100 whitespace-nowrap">📱 Mobil</td>
              <td class="px-6 py-4">
                <a href="tel:+436776231552" class="font-semibold text-[#1a1a1a] hover:text-brand-700 transition-colors">0677 623 11 552</a>
                <span class="block text-xs text-gray-400 mt-0.5">Montag – Freitag, 8:00 – 18:00 Uhr</span>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-semibold text-gray-500 bg-cream-100">✉️ E-Mail</td>
              <td class="px-6 py-4">
                <a href="mailto:termin@hautmitherz.at" class="font-semibold text-[#1a1a1a] hover:text-brand-700 transition-colors">termin@hautmitherz.at</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="text-center mt-5">
        <a href="https://patient.latido.at/arzt/_Scherz" target="_blank" rel="noopener" class="btn-cta">
          Terminvereinbarung →
        </a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {[
        { value: '15+', label: 'Jahre Erfahrung' },
        { value: '5.000+', label: 'Zufriedene Patientinnen' },
        { value: '20+', label: 'Behandlungen' },
        { value: '4.9 ★', label: 'Google Bewertung' },
      ].map(stat => (
        <div>
          <div class="font-display text-4xl font-extrabold text-[#1a1a1a] mb-1">{stat.value}</div>
          <div class="text-sm text-gray-600 font-medium">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Services preview -->
  <section class="bg-cream-200 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-[#1a1a1a] mb-4">Meine Leistungen</h2>
        <p class="text-gray-600 text-lg max-w-xl mx-auto">Von der Vorsorgeuntersuchung bis zur ästhetischen Behandlung – alles aus einer Hand.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          { icon: '🔬', title: 'Hautkrebs-Vorsorge', desc: 'Digitale Dermatoskopie und vollständige Ganzkörperanalyse zur Früherkennung von Hautveränderungen.' },
          { icon: '✨', title: 'Ästhetische Dermatologie', desc: 'Botox, Filler, Laser und mehr – für ein natürliches, strahlendes Erscheinungsbild.' },
          { icon: '💊', title: 'Akne & Rosacea', desc: 'Individuelle Therapiekonzepte für unreine Haut, Akne und Rosacea – nachhaltig und schonend.' },
          { icon: '🧴', title: 'Ekzeme & Allergien', desc: 'Diagnose und Behandlung von Neurodermitis, Kontaktallergien und entzündlichen Hauterkrankungen.' },
          { icon: '💉', title: 'Hyaluronsäure & Filler', desc: 'Sanfte Volumenkorrektur und Faltenbehandlung mit hochwertigen Produkten.' },
          { icon: '🌟', title: 'Laserbehandlungen', desc: 'Modernste Lasertechnologie für Pigmentflecken, Gefäßveränderungen und Hautverjüngung.' },
        ].map(item => (
          <div class="group p-8 rounded-2xl border border-cream-300 hover:border-brand-300 hover:shadow-lg hover:-translate-y-1 transition-all bg-cream-100">
            <div class="text-3xl mb-4">{item.icon}</div>
            <h3 class="font-display font-bold text-lg text-[#1a1a1a] mb-2">{item.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/services" class="btn-cta">Alle Leistungen →</a>
      </div>
    </div>
  </section>

  <!-- Image break -->
  <section class="relative h-72 sm:h-96 overflow-hidden">
    <img
      src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1400&q=80"
      alt="Moderne Arztpraxis"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-[#1a1a1a]/60 flex items-center justify-center">
      <div class="text-center text-white px-4">
        <h2 class="font-display text-3xl sm:text-4xl font-bold mb-4">Bereit für gesündere, strahlendere Haut?</h2>
        <a href="https://patient.latido.at/arzt/_Scherz" target="_blank" rel="noopener" class="inline-block px-8 py-3.5 bg-cream-100 hover:bg-white text-[#1a1a1a] font-semibold rounded-xl transition-all">
          Jetzt Termin vereinbaren
        </a>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid lg:grid-cols-2 gap-14 items-center">
      <img
        src="https://images.unsplash.com/photo-1551601651-2a8555f1a136?w=700&q=80"
        alt="Einfühlsame Behandlung"
        class="rounded-2xl shadow-xl w-full object-cover h-[400px]"
      />
      <div>
        <span class="text-brand-600 font-semibold text-sm uppercase tracking-wider">Warum Haut mit Herz?</span>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-[#1a1a1a] mt-2 mb-6">Medizin mit Herz und Verstand</h2>
        <div class="space-y-5">
          {[
            { icon: '🩺', title: 'Ganzheitliche Betreuung', desc: 'Ich nehme mir Zeit für Sie – ausführliche Gespräche, sorgfältige Diagnose, individuelle Therapie.' },
            { icon: '🏥', title: 'Modernste Ausstattung', desc: 'Digitale Dermatoskopie, aktuelle Lasertechnologie und evidenzbasierte Behandlungsmethoden.' },
            { icon: '💛', title: 'Persönliche Atmosphäre', desc: 'Keine Massenabfertigung – bei mir sind Sie als Mensch willkommen, nicht nur als Patientennummer.' },
            { icon: '📍', title: 'Zentral in Wien', desc: 'Gut erreichbar im Herzen Wiens – mit öffentlichen Verkehrsmitteln und Parkplatzmöglichkeiten.' },
          ].map(p => (
            <div class="flex gap-4">
              <span class="text-2xl flex-shrink-0 mt-0.5">{p.icon}</span>
              <div>
                <h3 class="font-semibold text-[#1a1a1a] mb-1">{p.title}</h3>
                <p class="text-gray-500 text-sm leading-relaxed">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 text-center">
    <div class="bg-[#1a1a1a] rounded-3xl px-8 py-16 text-white">
      <h2 class="font-display text-3xl sm:text-4xl font-bold mb-4">Ihre Haut verdient das Beste</h2>
      <p class="text-gray-300 text-lg mb-8 max-w-xl mx-auto">Vereinbaren Sie jetzt Ihren persönlichen Termin – ich freue mich auf Sie.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="https://patient.latido.at/arzt/_Scherz" target="_blank" rel="noopener" class="px-8 py-3.5 bg-cream-100 hover:bg-white text-[#1a1a1a] font-semibold rounded-xl transition-all shadow">
          Terminvereinbarung
        </a>
        <a href="/contact" class="px-8 py-3.5 border border-white/30 hover:border-white text-white font-semibold rounded-xl transition-all">
          Kontaktinformationen
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
