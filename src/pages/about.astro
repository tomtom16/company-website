---
import BaseLayout from '../layouts/BaseLayout.astro';
const GOOGLE_API_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
const PLACE_ID = import.meta.env.PUBLIC_GOOGLE_PLACE_ID;
const PLACE_LINK = `https://www.google.com/maps/place/?q=place_id:${PLACE_ID}`
---

<BaseLayout title="Über mich" description="Lernen Sie Dr. Scherz kennen – Ihr Dermatologe mit Herz in Wien.">

  <section class="bg-[#1a1a1a] text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold mb-4">Über mich</h1>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto">Erfahrung, Empathie und Leidenschaft für gesunde Haut – das ist mein Versprechen an Sie.</p>
    </div>
  </section>

  <!-- About the doctor -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid lg:grid-cols-2 gap-14 items-center">
      <div>
        <span class="text-brand-600 font-semibold text-sm uppercase tracking-wider">Ihr Arzt</span>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-[#1a1a1a] mt-2 mb-6">Dr. Thomas Scherz, PhD, FEBDV</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Nach meinem Medizinstudium an der Universität Wien spezialisierte ich mich auf Dermatologie und Venerologie. Meine Ausbildung führte mich durch renommierte Hautkliniken in Wien und ermöglichte mir ein breites Spektrum an klinischer Erfahrung – von komplexen Autoimmunerkrankungen der Haut bis zu feinsten ästhetischen Eingriffen.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          Meine Praxis „Haut mit Herz" gründete ich mit einer klaren Vision: Dermatologie zu bieten, die den Menschen in den Mittelpunkt stellt. Keine langen Wartezeiten, keine kurzen Gespräche – sondern echte Zuwendung, fundierte Diagnosen und Therapien, die zu Ihrem Leben passen.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Neben meiner klinischen Tätigkeit bilde ich mich regelmäßig auf internationalen Fachkongressen weiter, um Ihnen stets die neuesten und sichersten Behandlungsmethoden anbieten zu können.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {['Facharzt für Dermatologie', 'Ästhetische Medizin', 'Lasermedizin', 'Allergologie'].map(tag => (
            <span class="px-3 py-1 bg-cream-200 text-brand-800 text-xs font-semibold rounded-full border border-cream-300">{tag}</span>
          ))}
        </div>
      </div>
      <div>
        <img
          src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=700&q=80"
          alt="Dr. Scherz – Ihr Dermatologe"
          class="rounded-2xl shadow-xl w-full object-cover h-[460px]"
        />
      </div>
    </div>
  </section>

  <!-- Qualifications -->
  <section class="bg-cream-200 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-[#1a1a1a] mb-4">Ausbildung &amp; Qualifikationen</h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-6">
        {[
          { year: '2024', title: 'Zertifikat Lasermedizin', org: 'DALM – Deutsche Akademie für Lasermedizin' },
          { year: '2020', title: 'Diplom Ästhetische Dermatologie', org: 'ÖDG – Österreichische Dermatologische Gesellschaft' },
          { year: '2016', title: 'Facharzt für Dermatologie & Venerologie', org: 'Medizinische Universität Wien' },
          { year: '2012', title: 'Doktorat der Medizin (Dr. med.)', org: 'Universität Wien, Auszeichnung mit Einstimmigkeit' },
          { year: '2010', title: 'Studium der Humanmedizin', org: 'Medizinische Universität Wien' },
        ].map(item => (
          <div class="flex gap-6 items-start bg-cream-100 rounded-2xl p-6 border border-cream-300 shadow-sm">
            <div class="text-brand-600 font-display font-bold text-sm w-12 flex-shrink-0 mt-0.5">{item.year}</div>
            <div>
              <div class="font-semibold text-[#1a1a1a]">{item.title}</div>
              <div class="text-sm text-gray-500 mt-0.5">{item.org}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-14">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-[#1a1a1a] mb-4">Meine Philosophie</h2>
      <p class="text-gray-600 text-lg max-w-xl mx-auto">Die Werte, die meine Arbeit täglich leiten.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {[
        { icon: '❤️', title: 'Empathie', desc: 'Jede Patientin wird mit Respekt und Einfühlungsvermögen behandelt – ich höre wirklich zu.' },
        { icon: '🔬', title: 'Präzision', desc: 'Sorgfältige Diagnosen auf Basis modernster Technologie und evidenzbasierter Medizin.' },
        { icon: '🌱', title: 'Nachhaltigkeit', desc: 'Langfristige Hautgesundheit statt schneller Lösungen – gemeinsam entwickeln wir Ihre persönliche Routine.' },
        { icon: '🔒', title: 'Vertrauen', desc: 'Offene, ehrliche Kommunikation über alle Behandlungsoptionen, Risiken und Erwartungen.' },
      ].map(v => (
        <div class="bg-cream-200 rounded-2xl p-8 shadow-sm border border-cream-300 text-center">
          <div class="text-4xl mb-4">{v.icon}</div>
          <h3 class="font-display font-bold text-[#1a1a1a] mb-2">{v.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{v.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Google Reviews -->
  <section class="bg-cream-200 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-3 mb-3">
          <svg class="w-8 h-8" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-[#1a1a1a]">Patientenstimmen</h2>
        </div>

        <!-- Live reviews loaded via JS; static fallback shown until loaded -->
        <div id="reviews-summary" class="flex items-center justify-center gap-3 mt-2">
          <span class="font-display text-5xl font-extrabold text-[#1a1a1a]" id="avg-rating">…</span>
          <div>
            <div class="flex gap-0.5 text-2xl text-[#FBBC05]" id="avg-stars">★★★★★</div>
            <p class="text-gray-500 text-sm" id="review-count">Lade Bewertungen…</p>
          </div>
        </div>
      </div>

      <!-- Review cards injected by JS -->
      <div id="reviews-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6"></div>

      <!-- Static fallback if no API key is set -->
      <div id="reviews-fallback" class="hidden grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { name: 'Anna K.', stars: 5, initials: 'AK', color: 'bg-rose-500', date: 'März 2025', text: 'Dr. Scherz ist einfach wunderbar! Sie nimmt sich wirklich Zeit, hört zu und erklärt alles verständlich. Meine Hautprobleme wurden endlich richtig behandelt. Kann sie nur wärmstens empfehlen!' },
          { name: 'Michael B.', stars: 5, initials: 'MB', color: 'bg-blue-600', date: 'Februar 2025', text: 'Sehr professionelle und sympathische Ärztin. Die Praxis ist modern und einladend. Kurze Wartezeiten, ausführliche Beratung. Top!' },
          { name: 'Sophie W.', stars: 5, initials: 'SW', color: 'bg-green-600', date: 'Jänner 2025', text: 'Ich war wegen einer Hautveränderung dort und wurde super betreut. Dr. Scherz hat sich viel Zeit genommen und alle meine Fragen beantwortet. Sehr einfühlsam und kompetent.' },
          { name: 'Klaus M.', stars: 5, initials: 'KM', color: 'bg-purple-600', date: 'Dezember 2024', text: 'Endlich eine Dermatologin, die wirklich zuhört! Die Behandlung meiner Akne war nachhaltig erfolgreich. Ich bin seit einem Jahr Patientin und super zufrieden.' },
          { name: 'Laura H.', stars: 5, initials: 'LH', color: 'bg-amber-600', date: 'November 2024', text: 'Botox-Behandlung sehr professionell durchgeführt, natürliches Ergebnis, genau wie ich es wollte. Kompetente und herzliche Ärztin.' },
          { name: 'Thomas P.', stars: 4, initials: 'TP', color: 'bg-teal-600', date: 'Oktober 2024', text: 'Sehr gute Ärztin, einfühlsam und fachkundig. Ich kam mit einem hartnäckigen Ekzem und nach wenigen Wochen war alles abgeheilt. Leichte Wartezeit beim Termin, aber absolut in Ordnung.' },
        ].map(r => (
          <div class="bg-cream-100 rounded-2xl p-6 border border-cream-300 shadow-sm flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <div class={`w-10 h-10 rounded-full ${r.color} flex items-center justify-center text-white font-bold text-sm flex-shrink-0`}>{r.initials}</div>
              <div class="min-w-0">
                <div class="font-semibold text-[#1a1a1a] text-sm truncate">{r.name}</div>
                <div class="text-xs text-gray-400">{r.date}</div>
              </div>
              <svg class="w-5 h-5 ml-auto flex-shrink-0" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            </div>
            <div class="text-[#FBBC05]">{'★'.repeat(r.stars)}{'☆'.repeat(5 - r.stars)}</div>
            <p class="text-gray-600 text-sm leading-relaxed">{r.text}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href={PLACE_LINK} target="_blank" rel="noopener" class="btn-cta">
          Alle Bewertungen auf Google →
        </a>
      </div>
    </div>
  </section>

  <!--
    To load LIVE Google reviews:
    1. Get a Maps JavaScript API key with Places API enabled at console.cloud.google.com
    2. Replace YOUR_GOOGLE_API_KEY below with your real key
    3. The reviews will load automatically; the static fallback cards will be hidden
  -->
  <script define:vars={{ GOOGLE_API_KEY, PLACE_ID }}>
    if (GOOGLE_API_KEY && GOOGLE_API_KEY !== 'YOUR_GOOGLE_API_KEY') {
      window.__initGoogleReviews = async () => {
        try {
          const { Place } = await window.google.maps.importLibrary('places');
          const place = new Place({ id: PLACE_ID });
          await place.fetchFields({ fields: ['displayName', 'rating', 'userRatingCount', 'reviews'] });

          const avgEl = document.getElementById('avg-rating');
          const countEl = document.getElementById('review-count');
          if (avgEl) avgEl.textContent = place.rating?.toFixed(1) ?? '–';
          if (countEl) countEl.textContent = `Basierend auf ${place.userRatingCount ?? 0} Google-Bewertungen`;

          const grid = document.getElementById('reviews-grid');
          const fallback = document.getElementById('reviews-fallback');
          if (grid && place.reviews?.length) {
            fallback?.classList.add('hidden');
            const colors = ['bg-rose-500','bg-blue-600','bg-green-600','bg-purple-600','bg-amber-600','bg-teal-600'];
            place.reviews.slice(0, 3).forEach((r, i) => {
              const name = r.authorAttribution?.displayName ?? 'Anonym';
              const initials = name.split(' ').map((n) => n[0]).join('').slice(0,2).toUpperCase();
              const stars = r.rating ?? 5;
              const text = r.text ?? '';
              const relTime = r.relativePublishTimeDescription ?? '';
              grid.innerHTML += `
                <div class="bg-cream-100 rounded-2xl p-6 border border-cream-300 shadow-sm flex flex-col gap-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full ${colors[i % colors.length]} flex items-center justify-center text-white font-bold text-sm flex-shrink-0">${initials}</div>
                    <div class="min-w-0">
                      <div class="font-semibold text-[#1a1a1a] text-sm truncate">${name}</div>
                      <div class="text-xs text-gray-400">${relTime}</div>
                    </div>
                    <svg class="w-5 h-5 ml-auto flex-shrink-0" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                  </div>
                  <div class="text-[#FBBC05]">${'★'.repeat(stars)}${'☆'.repeat(5-stars)}</div>
                  <p class="text-gray-600 text-sm leading-relaxed">${text}</p>
                </div>`;
            });
          } else {
            fallback?.classList.remove('hidden');
          }
        } catch(e) {
          document.getElementById('reviews-fallback')?.classList.remove('hidden');
          const countEl = document.getElementById('review-count');
          if (countEl) countEl.textContent = 'Beispiel-Bewertungen';
        }
      };

      const script = document.createElement('script');
      script.src = `https://maps.googleapis.com/maps/api/js?key=${GOOGLE_API_KEY}&callback=__initGoogleReviews&libraries=places&v=weekly`;
      script.async = true;
      document.head.appendChild(script);
    } else {
      // No API key — show static fallback immediately
      document.getElementById('reviews-fallback')?.classList.remove('hidden');
      const avgEl = document.getElementById('avg-rating');
      const countEl = document.getElementById('review-count');
      if (avgEl) avgEl.textContent = '4.9';
      if (countEl) countEl.textContent = 'Beispiel-Bewertungen (API-Key erforderlich für Live-Daten)';
    }
  </script>

</BaseLayout>
