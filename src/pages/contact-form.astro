---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Anfrage" description="Schicken Sie uns eine Nachricht – wir melden uns so schnell wie möglich.">

  <section class="bg-[#1a1a1a] text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold mb-4">Schreiben Sie uns</h1>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto">Fragen zu Behandlungen oder Terminen? Wir antworten innerhalb eines Werktages.</p>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="bg-white rounded-3xl shadow-xl border border-cream-300 p-10">

      <form id="contact-form" class="space-y-6" novalidate>
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="first-name" class="block text-sm font-semibold text-gray-700 mb-1.5">Vorname <span class="text-red-500">*</span></label>
            <input type="text" id="first-name" name="first_name" required
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent text-sm transition bg-cream-50"
              placeholder="Maria"
            />
          </div>
          <div>
            <label for="last-name" class="block text-sm font-semibold text-gray-700 mb-1.5">Nachname <span class="text-red-500">*</span></label>
            <input type="text" id="last-name" name="last_name" required
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent text-sm transition bg-cream-50"
              placeholder="Muster"
            />
          </div>
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">E-Mail-Adresse <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="reply_to" required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent text-sm transition bg-cream-50"
            placeholder="maria@beispiel.at"
          />
        </div>

        <div>
          <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1.5">Telefonnummer</label>
          <input type="tel" id="phone" name="phone"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent text-sm transition bg-cream-50"
            placeholder="+43 660 123 456"
          />
        </div>

        <div>
          <label for="service" class="block text-sm font-semibold text-gray-700 mb-1.5">Thema / Behandlung</label>
          <select id="service" name="service"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent text-sm bg-cream-50 transition"
          >
            <option value="">Bitte wählen…</option>
            <option>Hautkrebs-Vorsorge</option>
            <option>Ästhetische Behandlung (Botox/Filler)</option>
            <option>Laserbehandlung</option>
            <option>Akne / Rosacea</option>
            <option>Ekzem / Allergie</option>
            <option>Allgemeine Anfrage</option>
            <option>Sonstiges</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-semibold text-gray-700 mb-1.5">Nachricht <span class="text-red-500">*</span></label>
          <textarea id="message" name="message" rows="5" required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent text-sm transition resize-none bg-cream-50"
            placeholder="Beschreiben Sie Ihr Anliegen oder Ihre Frage…"
          ></textarea>
        </div>

        <div class="flex items-start gap-3">
          <input type="checkbox" id="privacy" name="privacy" required class="mt-1 w-4 h-4 rounded border-gray-300 focus:ring-brand-400" />
          <label for="privacy" class="text-sm text-gray-500">
            Ich habe die <a href="/data-protection" class="text-brand-700 hover:underline">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Daten einverstanden. <span class="text-red-500">*</span>
          </label>
        </div>

        <div id="error-msg" class="hidden py-3 px-5 bg-red-50 text-red-700 rounded-xl text-sm border border-red-200">
          ⚠️ <span id="error-text">Etwas ist schiefgelaufen. Bitte versuchen Sie es erneut.</span>
        </div>

        <button type="submit" id="submit-btn"
          class="w-full py-4 bg-[#1a1a1a] hover:bg-[#2d2d2d] text-white font-semibold rounded-xl transition-all shadow-sm text-sm flex items-center justify-center gap-2"
        >
          <span id="btn-label">Nachricht senden →</span>
          <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
        </button>
      </form>

      <div id="success-msg" class="hidden text-center py-12">
        <div class="text-5xl mb-4">✅</div>
        <h3 class="font-display font-bold text-2xl text-[#1a1a1a] mb-2">Nachricht gesendet!</h3>
        <p class="text-gray-500">Vielen Dank für Ihre Anfrage. Wir melden uns innerhalb eines Werktages bei Ihnen.</p>
        <div class="mt-6">
          <a href="https://patient.latido.at/arzt/_Scherz" target="_blank" rel="noopener" class="btn-cta">
            Direkt online Termin buchen →
          </a>
        </div>
      </div>
    </div>

    <div id="setup-notice" class="mt-6 p-5 bg-amber-50 border border-amber-200 rounded-2xl text-sm text-amber-800">
      <strong>⚙️ EmailJS-Konfiguration erforderlich</strong><br/>
      Um den E-Mail-Versand zu aktivieren, ersetzen Sie die drei Platzhalter im Skript unten:
      <ol class="list-decimal list-inside mt-2 space-y-1">
        <li>Kostenlosen Account auf <a href="https://www.emailjs.com" target="_blank" class="underline">emailjs.com</a> erstellen</li>
        <li><strong>E-Mail-Service</strong> einrichten (Gmail, Outlook, SMTP…) → <strong>Service ID</strong> kopieren</li>
        <li><strong>E-Mail-Template</strong> erstellen → <strong>Template ID</strong> kopieren<br/>
          Template-Variablen: <code>&#123;&#123;first_name&#125;&#125;</code> <code>&#123;&#123;last_name&#125;&#125;</code> <code>&#123;&#123;reply_to&#125;&#125;</code> <code>&#123;&#123;phone&#125;&#125;</code> <code>&#123;&#123;service&#125;&#125;</code> <code>&#123;&#123;message&#125;&#125;</code>
        </li>
        <li><strong>Account → API Keys</strong> → <strong>Public Key</strong> kopieren</li>
        <li>Die drei Konstanten in <code>src/pages/contact-form.astro</code> ersetzen</li>
        <li>Diese gelbe Box löschen ✅</li>
      </ol>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
  <script>
    const EMAILJS_PUBLIC_KEY  = 'YOUR_PUBLIC_KEY';
    const EMAILJS_SERVICE_ID  = 'YOUR_SERVICE_ID';
    const EMAILJS_TEMPLATE_ID = 'YOUR_TEMPLATE_ID';

    (window as any).emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });

    const form       = document.getElementById('contact-form') as HTMLFormElement;
    const successDiv = document.getElementById('success-msg');
    const errorDiv   = document.getElementById('error-msg');
    const errorText  = document.getElementById('error-text');
    const submitBtn  = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnLabel   = document.getElementById('btn-label');
    const spinner    = document.getElementById('btn-spinner');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      submitBtn.disabled = true;
      btnLabel!.textContent = 'Wird gesendet…';
      spinner?.classList.remove('hidden');
      errorDiv?.classList.add('hidden');
      try {
        await (window as any).emailjs.sendForm(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, form);
        form.classList.add('hidden');
        successDiv?.classList.remove('hidden');
        document.getElementById('setup-notice')?.classList.add('hidden');
      } catch (err: any) {
        errorText!.textContent = err?.text || 'Fehler beim Senden. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt.';
        errorDiv?.classList.remove('hidden');
        submitBtn.disabled = false;
        btnLabel!.textContent = 'Nachricht senden →';
        spinner?.classList.add('hidden');
      }
    });
  </script>

</BaseLayout>
